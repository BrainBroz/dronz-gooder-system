model Recebimento {
  id              String                @id @default(cuid())
  lojaId          String
  viagemId        String
  malaId          String
  status          RecebimentoStatus     @default(PENDING)
  iniciadoEm      DateTime
  concluidoEm     DateTime?
  confirmadoPorId String
  observacoes     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  supersededAt    DateTime?
  loja            Loja                  @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  viagem          Viagem                @relation(fields: [viagemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  mala            Mala                  @relation(fields: [malaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  confirmadoPor   Usuario               @relation(fields: [confirmadoPorId], references: [id], onDelete: Restrict)
  itens           RecebimentoItem[]
  movimentacoes   MovimentacaoEstoque[]

  @@unique([id, lojaId])
  @@index([lojaId, status])
}

model RecebimentoItem {
  id                      String                     @id @default(cuid())
  lojaId                  String
  recebimentoId           String
  pedidoCompraItemId      String
  produtoId               String
  quantidadeEsperada      Int
  quantidadeRecebida      Int                        @default(0)
  quantidadeRejeitada     Int                        @default(0)
  quantidadeJaIncorporada Int                        @default(0)
  observacoes             String?
  tipoDivergencia         TipoDivergenciaRecebimento @default(CORRETO)
  divergenciaResolvida    Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  loja                    Loja                       @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  recebimento             Recebimento                @relation(fields: [recebimentoId, lojaId], references: [id, lojaId], onDelete: Cascade)
  pedidoItem              PedidoCompraItem           @relation(fields: [pedidoCompraItemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  produto                 Produto                    @relation(fields: [produtoId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([recebimentoId, pedidoCompraItemId])
  @@index([lojaId, produtoId])
}

model Estoque {
  id                  String                @id @default(cuid())
  lojaId              String
  produtoId           String
  quantidadeFisica    Int                   @default(0)
  quantidadeReservada Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  loja                Loja                  @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  produto             Produto               @relation(fields: [produtoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  movimentacoes       MovimentacaoEstoque[]

  @@unique([lojaId, produtoId])
  @@unique([id, lojaId])
}

model EstoqueEntrada {
  id              String               @id @default(cuid())
  lojaId          String
  viagemId        String
  malaId          String
  confirmadoPorId String
  confirmadoEm    DateTime
  status          EstoqueEntradaStatus @default(PENDING)
  observacao      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  supersededAt    DateTime?

  loja          Loja    @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  viagem        Viagem  @relation(fields: [viagemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  mala          Mala    @relation(fields: [malaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  confirmadoPor Usuario @relation(fields: [confirmadoPorId], references: [id], onDelete: Restrict)

  @@index([lojaId, viagemId])
  @@index([lojaId, malaId])
  @@index([lojaId, status])
}

model MovimentacaoEstoque {
  id                  String                    @id @default(cuid())
  lojaId              String
  produtoId           String
  estoqueId           String
  recebimentoId       String?
  tipo                MovimentacaoEstoqueTipo
  motivo              MovimentacaoEstoqueMotivo
  quantidade          Int
  quantidadeAnterior  Int
  quantidadePosterior Int
  responsavelId       String
  observacoes         String?
  movimentoOriginalId String?
  // Lote de origem (B17): ENTRY ligada ao item de compra, base do custo específico (X-10).
  pedidoCompraItemId  String?
  // Auditoria PD-02: lote de devolução herda o custo congelado da baixa original.
  baixaOrigemId       String?
  createdAt           DateTime                  @default(now())
  loja                Loja                      @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  produto             Produto                   @relation(fields: [produtoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  estoque             Estoque                   @relation(fields: [estoqueId, lojaId], references: [id, lojaId], onDelete: Restrict)
  recebimento         Recebimento?              @relation(fields: [recebimentoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  responsavel         Usuario                   @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  movimentoOriginal   MovimentacaoEstoque?      @relation("MovimentoCompensacao", fields: [movimentoOriginalId, lojaId], references: [id, lojaId], onDelete: Restrict)
  compensacoes        MovimentacaoEstoque[]     @relation("MovimentoCompensacao")
  pedidoItem          PedidoCompraItem?         @relation(fields: [pedidoCompraItemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  // Tenant-safe: a baixa de origem é sempre da mesma loja da movimentação.
  baixaOrigem         BaixaVenda?               @relation("BaixaOrigemDevolucao", fields: [baixaOrigemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  baixasComoLote      BaixaVenda[]              @relation("BaixaLote")
  baixasComoSaida     BaixaVenda[]              @relation("BaixaSaida")
  reconciliacoesLote  ReconciliacaoLote[]       @relation("ReconciliacaoLote")
  reconciliacoesSaida ReconciliacaoLote[]       @relation("ReconciliacaoSaida")

  @@unique([id, lojaId])
  @@index([lojaId, produtoId, createdAt])
  @@index([lojaId, tipo])
  @@index([movimentoOriginalId])
}

enum PagamentoStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum FormaPagamento {
  CREDIT_CARD
  PAYPAL
  BANK_TRANSFER
  CASH
  OTHER
}

model CotacaoCambio {
  id            String        @id @default(cuid())
  lojaId        String
  moedaOrigem   String
  moedaDestino  String
  valorMercado  Decimal       @db.Decimal(18, 6)
  margem        Decimal       @db.Decimal(18, 6)
  valor         Decimal       @db.Decimal(18, 6)
  fonte         String?
  cotadoEm      DateTime
  responsavelId String
  createdAt     DateTime      @default(now())
  loja          Loja          @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  responsavel   Usuario       @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  custos        CustoPedido[]

  simulacoesCompra SimulacaoCompra[]

  @@unique([id, lojaId])
  @@index([lojaId, cotadoEm])
}

model Despesa {
  id          String           @id @default(cuid())
  lojaId      String
  categoria   DespesaCategoria
  descricao   String
  valor       Decimal          @db.Decimal(12, 2)
  dataDespesa DateTime
  observacoes String?
  moeda       String           @default("BRL")
  impacto     ImpactoDespesa   @default(DESPESA_RESULTADO)
  // Origem vinculada impede contabilizar o mesmo fato duas vezes (B16).
  origemTipo  String?
  origemId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  loja        Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  @@unique([id, lojaId])
  @@unique([lojaId, origemTipo, origemId])
  @@index([lojaId, categoria])
  @@index([lojaId, dataDespesa])
}

model Pagamento {
  id                String                  @id @default(cuid())
  lojaId            String
  pedidoCompraId    String
  formaPagamento    FormaPagamento
  moeda             String
  valor             Decimal                 @db.Decimal(12, 2)
  status            PagamentoStatus
  pagoEm            DateTime?
  referencia        String?
  observacoes       String?
  estornoDeId       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  loja              Loja                    @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pedido            PedidoCompra            @relation(fields: [pedidoCompraId, lojaId], references: [id, lojaId], onDelete: Restrict)
  lancamentosCartao LancamentoCartao[]
  conciliacoes      ConciliacaoFinanceira[]

  @@unique([id, lojaId])
  @@index([lojaId, pedidoCompraId, status])
}

// Batch 16: contas, faturas, fontes e conciliação. Todo valor é Decimal com moeda explícita.
enum ImpactoDespesa {
  DESPESA_RESULTADO
  TRANSFERENCIA
  CUSTO_AQUISICAO
  APLICACAO_CAPITAL
}

enum TipoContaFinanceira {
  PAYPAL
  CARTAO
  BANCO
  CAIXA
}

enum StatusContaFinanceira {
  ATIVA
  INATIVA
}

enum StatusFaturaCartao {
  ABERTA
  FECHADA
  QUITADA
}

enum TipoLancamentoCartao {
  DEBITO
  CREDITO
  TAXA
  AJUSTE
}

enum TipoTransacaoFonte {
  COMPRA
  TAXA
  CONVERSAO
  REEMBOLSO
  PAGAMENTO_FATURA
}

enum StatusConciliacaoFinanceira {
  PENDENTE_REVISAO
  CONCILIADO
  POSSIVEL_DUPLICIDADE
  SEM_PAGAMENTO_ASSOCIADO
  IGNORADO
}

// Cartão é uma conta do tipo CARTAO (1:1 com a entidade conceitual Cartao). Nunca guarda PAN, CVV ou token.
model ContaFinanceira {
  id                String                     @id @default(cuid())
  lojaId            String
  tipo              TipoContaFinanceira
  apelido           String
  moedaPrincipal    String
  estado            StatusContaFinanceira      @default(ATIVA)
  referenciaExterna String?
  emissor           String?
  ultimosQuatro     String?                    @db.VarChar(4)
  diaFechamento     Int?
  diaVencimento     Int?
  limite            Decimal?                   @db.Decimal(18, 2)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  loja              Loja                       @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  faturas           FaturaCartao[]
  transacoes        TransacaoFinanceiraFonte[]
  pagamentosFatura  PagamentoFatura[]

  @@unique([id, lojaId])
  @@unique([lojaId, apelido])
}

model FaturaCartao {
  id          String             @id @default(cuid())
  lojaId      String
  contaId     String
  moeda       String
  inicio      DateTime           @db.Date
  fim         DateTime           @db.Date
  vencimento  DateTime           @db.Date
  estado      StatusFaturaCartao @default(ABERTA)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  loja        Loja               @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  conta       ContaFinanceira    @relation(fields: [contaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  lancamentos LancamentoCartao[]
  pagamentos  PagamentoFatura[]

  @@unique([id, lojaId])
  @@unique([contaId, inicio])
}

// Lançamento é o compromisso no cartão; parcelas repartem o pagamento original sem recriar custo.
model LancamentoCartao {
  id            String               @id @default(cuid())
  lojaId        String
  faturaId      String
  tipo          TipoLancamentoCartao
  valor         Decimal              @db.Decimal(18, 2)
  data          DateTime
  descricao     String?
  pagamentoId   String?
  parcelaNumero Int?
  parcelaTotal  Int?
  createdAt     DateTime             @default(now())
  loja          Loja                 @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  fatura        FaturaCartao         @relation(fields: [faturaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  pagamento     Pagamento?           @relation(fields: [pagamentoId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([pagamentoId, parcelaNumero])
  @@index([lojaId, faturaId])
}

// Pagamento da fatura liquida a dívida do cartão; não é nova despesa de compra.
model PagamentoFatura {
  id            String           @id @default(cuid())
  lojaId        String
  faturaId      String
  contaOrigemId String?
  valor         Decimal          @db.Decimal(18, 2)
  pagoEm        DateTime
  referencia    String?
  createdAt     DateTime         @default(now())
  loja          Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  fatura        FaturaCartao     @relation(fields: [faturaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  contaOrigem   ContaFinanceira? @relation(fields: [contaOrigemId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@index([lojaId, faturaId])
}

// Fonte externa ou manual (PayPal/extrato). Conteúdo novo gera versão; a anterior nunca é sobrescrita.
model TransacaoFinanceiraFonte {
  id            String                 @id @default(cuid())
  lojaId        String
  contaId       String
  provider      String
  transactionId String
  versao        Int                    @default(1)
  tipo          TipoTransacaoFonte
  moeda         String
  bruto         Decimal                @db.Decimal(18, 2)
  taxa          Decimal?               @db.Decimal(18, 2)
  liquido       Decimal?               @db.Decimal(18, 2)
  occurredAt    DateTime
  statusFonte   String?
  contraparte   String?
  payloadHash   String
  substituidaEm DateTime?
  createdAt     DateTime               @default(now())
  loja          Loja                   @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  conta         ContaFinanceira        @relation(fields: [contaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  conciliacao   ConciliacaoFinanceira?

  @@unique([id, lojaId])
  @@unique([contaId, provider, transactionId, versao])
  @@index([lojaId, occurredAt])
}

// Vínculo humano entre fonte e pagamento já registrado: concilia sem criar pagamento duplicado.
model ConciliacaoFinanceira {
  id                  String                      @id @default(cuid())
  lojaId              String
  transacaoFonteId    String                      @unique
  pagamentoId         String?
  sugeridoPagamentoId String?
  estado              StatusConciliacaoFinanceira
  motivo              String?
  revisadoPorId       String?
  revisadoEm          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  loja                Loja                        @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  transacao           TransacaoFinanceiraFonte    @relation(fields: [transacaoFonteId, lojaId], references: [id, lojaId], onDelete: Restrict)
  pagamento           Pagamento?                  @relation(fields: [pagamentoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  revisadoPor         Usuario?                    @relation(fields: [revisadoPorId], references: [id], onDelete: Restrict)

  @@unique([transacaoFonteId, lojaId])
  @@index([lojaId, estado])
  @@index([pagamentoId])
}

model CustoPedido {
  id              String            @id @default(cuid())
  lojaId          String
  pedidoCompraId  String
  cotacaoCambioId String?
  iofPercentual   Decimal           @default(0) @db.Decimal(8, 6)
  iofValor        Decimal           @default(0) @db.Decimal(12, 2)
  taxas           Decimal           @default(0) @db.Decimal(12, 2)
  custoAdicional  Decimal           @default(0) @db.Decimal(12, 2)
  totalGlobal     Decimal           @default(0) @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  loja            Loja              @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pedido          PedidoCompra      @relation(fields: [pedidoCompraId, lojaId], references: [id, lojaId], onDelete: Restrict)
  cotacaoCambio   CotacaoCambio?    @relation(fields: [cotacaoCambioId, lojaId], references: [id, lojaId], onDelete: Restrict)
  itens           CustoPedidoItem[]

  @@unique([pedidoCompraId, lojaId])
  @@unique([id, lojaId])
  @@index([lojaId, pedidoCompraId])
}

model CustoPedidoItem {
  id                 String           @id @default(cuid())
  lojaId             String
  custoPedidoId      String
  pedidoCompraItemId String
  custoRateado       Decimal          @db.Decimal(12, 2)
  custoTotalUnitario Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  custo              CustoPedido      @relation(fields: [custoPedidoId, lojaId], references: [id, lojaId], onDelete: Cascade)
  pedidoItem         PedidoCompraItem @relation(fields: [pedidoCompraItemId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([custoPedidoId, pedidoCompraItemId])
  @@index([lojaId, pedidoCompraItemId])
}

enum SimulacaoRisco {
  SEM_RISCO
  SIMULACAO
  EFETIVADA
}

model SimulacaoViagem {
