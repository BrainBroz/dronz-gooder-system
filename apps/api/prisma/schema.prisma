model SimulacaoViagemCusto {
  id                String   @id @default(cuid())
  lojaId            String
  simulacaoViagemId String
  comissao          Decimal  @default(0) @db.Decimal(12, 2)
  passagens         Decimal  @default(0) @db.Decimal(12, 2)
  hotel             Decimal  @default(0) @db.Decimal(12, 2)
  carro             Decimal  @default(0) @db.Decimal(12, 2)
  alimentacao       Decimal  @default(0) @db.Decimal(12, 2)
  gasolina          Decimal  @default(0) @db.Decimal(12, 2)
  diversos          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  simulacao SimulacaoViagem @relation(fields: [simulacaoViagemId, lojaId], references: [id, lojaId], onDelete: Cascade)

  @@unique([id, lojaId])
  @@unique([simulacaoViagemId, lojaId])
}

model SimulacaoViagemParametro {
  id                 String   @id @default(cuid())
  lojaId             String
  simulacaoViagemId  String
  custoEnvioPorKgUsd Decimal  @db.Decimal(12, 4)
  cotacaoDolar       Decimal  @db.Decimal(18, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  simulacao SimulacaoViagem @relation(fields: [simulacaoViagemId, lojaId], references: [id, lojaId], onDelete: Cascade)

  @@unique([id, lojaId])
  @@unique([simulacaoViagemId, lojaId])
}

model AtribuicaoItem {
  id                 String   @id @default(cuid())
  compraImportadaId  String?
  pedidoCompraItemId String
  lojaId             String
  quantidade         Int
  atribuidoPorId     String
  atribuidoEm        DateTime @default(now())
  observacao         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  compraImportada  CompraImportada? @relation(fields: [compraImportadaId], references: [id], onDelete: Cascade)
  pedidoCompraItem PedidoCompraItem @relation(fields: [pedidoCompraItemId, lojaId], references: [id, lojaId], onDelete: Cascade)
  loja             Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  atribuidoPor     Usuario          @relation(fields: [atribuidoPorId], references: [id], onDelete: Restrict)

  @@unique([pedidoCompraItemId, lojaId])
  @@index([lojaId, atribuidoEm])
  @@index([compraImportadaId])
}

// Posições operacionais (D-2): endereço físico reutilizável e a operação nele. Globais,
// pois a mesma base atende às duas lojas; não criam estoque patrimonial.
enum TipoPosicao {
  PERMANENTE
  TEMPORARIA
}

enum StatusPosicao {
  CRIADA
  ATIVA
  ENCERRADA
  CANCELADA
}

enum PapelResponsabilidade {
  PRINCIPAL
  DELEGADO
}

enum StatusReservaMala {
  RESERVADA
  CONSUMIDA
}

model Local {
  id        String               @id @default(cuid())
  alias     String
  cidade    String
  estado    String?
  pais      String
  timezone  String
  endereco  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  posicoes  PosicaoOperacional[]
}

model PosicaoOperacional {
  id                String                       @id @default(cuid())
  localId           String
  codigo            String                       @unique
  nome              String
  tipo              TipoPosicao
  status            StatusPosicao                @default(CRIADA)
  inicioEm          DateTime?
  fimEm             DateTime?
  encerradaEm       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  local             Local                        @relation(fields: [localId], references: [id], onDelete: Restrict)
  responsabilidades ResponsabilidadeContextual[]
  pedidosDestinados PedidoCompra[]
  pacotesDestinados PacoteExterno[]
  malas             Mala[]
  recebimentosMiami RecebimentoMiami[]

  @@index([status])
}

model ResponsabilidadeContextual {
  id         String                @id @default(cuid())
  posicaoId  String
  usuarioId  String
  papel      PapelResponsabilidade
  validoDe   DateTime
  validoAte  DateTime?
  revogadoEm DateTime?
  createdAt  DateTime              @default(now())
  posicao    PosicaoOperacional    @relation(fields: [posicaoId], references: [id], onDelete: Restrict)
  usuario    Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([posicaoId, usuarioId])
}

enum ModalidadeEnvio {
  MALA_VIAJANTE
  CAIXA_AEREA
}

enum TipoVolumeEnvio {
  MALA
  CAIXA
}

// D-11: um volume físico pode reunir as partes (por loja) de uma mesma mala ou caixa;
// o limite de peso vale para o total físico, e cada parte mantém loja e custos próprios.
model GrupoFisico {
  id           String          @id @default(cuid())
  codigo       String          @unique
  tipo         TipoVolumeEnvio
  limitePesoKg Decimal?        @db.Decimal(8, 3)
  createdAt    DateTime        @default(now())
  partes       Mala[]
}

// D-13: entrega de volume a transportador ou viajante, com responsáveis e instante do servidor.
model HandoffVolume {
  id            String   @id @default(cuid())
  lojaId        String
  malaId        String
  entreguePorId String
  recebidoPor   String
  referencia    String?
  observacao    String?
  ocorridoEm    DateTime @default(now())
  loja          Loja     @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  mala          Mala     @relation(fields: [malaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  entreguePor   Usuario  @relation(fields: [entreguePorId], references: [id], onDelete: Restrict)

  @@index([lojaId, malaId])
}

// D-4: condição em dimensões separadas; não altera aptidão para entrada/venda até política própria.
enum CondicaoComercial {
  NAO_DEFINIDA
  NOVO
  CAIXA_ABERTA
  USADO
}

enum Funcionamento {
  NAO_TESTADO
  FUNCIONAL
  DEFEITO_PARCIAL
  INOPERANTE
}

enum StatusSolicitacaoCorrecao {
  PENDENTE
  APROVADA
  REJEITADA
}

// D-17: correção com efeito patrimonial é proposta por um usuário e aplicada só após aval de outro.
model SolicitacaoCorrecao {
  id                String                    @id @default(cuid())
  lojaId            String
  payload           Json
  status            StatusSolicitacaoCorrecao @default(PENDENTE)
  propostoPorId     String
  decididoPorId     String?
  decididoEm        DateTime?
  motivoDecisao     String?
  eventoCorretivoId String?
  createdAt         DateTime                  @default(now())
  loja              Loja                      @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  propostoPor       Usuario                   @relation("CorrecaoProponente", fields: [propostoPorId], references: [id], onDelete: Restrict)
  decididoPor       Usuario?                  @relation("CorrecaoAprovador", fields: [decididoPorId], references: [id], onDelete: Restrict)

  @@index([lojaId, status])
}

// X-01: divergência só se resolve por decisão humana motivada; nenhuma tolerância a encerra sozinha.
enum ResolucaoConflitoEvidencia {
  ACEITAR_EVIDENCIA
  MANTER_REFERENCIA
  CIENTE
}

// Batch 17: vendas e baixa patrimonial. Só estoque Brasil disponível (físico − reservado) é vendável.
enum CanalVenda {
  MERCADO_LIVRE
  SHOPEE
  SITE_PROPRIO
  OUTRO
}

enum StatusVenda {
  RASCUNHO
  CONFIRMADA
  CANCELADA
  ESTORNADA
}

enum StatusDevolucaoVenda {
  PENDENTE
  CONFERIDA
  REJEITADA
}

enum StatusRecebivelVenda {
  PENDENTE
  PARCIAL
  RECEBIDO
  ESTORNADO
}

model Venda {
  id                String           @id @default(cuid())
  lojaId            String
  canal             CanalVenda
  referenciaExterna String?
  dataVenda         DateTime
  moeda             String
  estado            StatusVenda      @default(RASCUNHO)
  observacao        String?
  criadoPorId       String
  confirmadoPorId   String?
  confirmadoEm      DateTime?
  // PD-01: estorno vinculado; a venda original (receita e custo) permanece intacta.
  estornadaEm       DateTime?
  estornadaPorId    String?
  motivoEstorno     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  loja              Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  criadoPor         Usuario          @relation("VendaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  confirmadoPor     Usuario?         @relation("VendaConfirmadaPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict)
  itens             VendaItem[]
  recebivel         RecebivelVenda?
  devolucoes        DevolucaoVenda[]

  @@unique([id, lojaId])
  @@unique([lojaId, canal, referenciaExterna])
  @@index([lojaId, dataVenda])
  @@index([lojaId, estado])
}

// Encargos são valores informados por item (snapshot); nenhum percentual é presumido pelo canal (X-08).
model VendaItem {
  id              String           @id @default(cuid())
  lojaId          String
  vendaId         String
  produtoId       String
  quantidade      Int
  precoUnitario   Decimal          @db.Decimal(18, 2)
  desconto        Decimal          @default(0) @db.Decimal(18, 2)
  taxaMarketplace Decimal          @default(0) @db.Decimal(18, 2)
  notaFiscal      Decimal          @default(0) @db.Decimal(18, 2)
  frete           Decimal          @default(0) @db.Decimal(18, 2)
  createdAt       DateTime         @default(now())
  loja            Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  venda           Venda            @relation(fields: [vendaId, lojaId], references: [id, lojaId], onDelete: Cascade)
  produto         Produto          @relation(fields: [produtoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  baixas          BaixaVenda[]
  devolucoes      DevolucaoVenda[]

  @@unique([id, lojaId])
  @@index([lojaId, produtoId])
}

// Uma linha de venda pode consumir vários lotes; custo é snapshot no instante da confirmação.
model BaixaVenda {
  id                      String                @id @default(cuid())
  lojaId                  String
  vendaItemId             String
  movimentoEntradaId      String
  movimentoSaidaId        String
  quantidade              Int
  custoUnitario           Decimal?              @db.Decimal(18, 2)
  moedaCusto              String?
  custoUnitarioConvertido Decimal?              @db.Decimal(18, 2)
  cotacaoCambioId         String?
  politica                String
  // PD-01: baixa revertida devolve o saldo ao lote original.
  revertidaEm             DateTime?
  lotesDevolucao          MovimentacaoEstoque[] @relation("BaixaOrigemDevolucao")
  createdAt               DateTime              @default(now())
  loja                    Loja                  @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  item                    VendaItem             @relation(fields: [vendaItemId, lojaId], references: [id, lojaId], onDelete: Restrict)
  lote                    MovimentacaoEstoque   @relation("BaixaLote", fields: [movimentoEntradaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  saida                   MovimentacaoEstoque   @relation("BaixaSaida", fields: [movimentoSaidaId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([id, lojaId])
  @@index([lojaId, movimentoEntradaId])
  @@index([vendaItemId])
}

model RecebivelVenda {
  id               String               @id @default(cuid())
  lojaId           String
  vendaId          String               @unique
  moeda            String
  valorPrevisto    Decimal              @db.Decimal(18, 2)
  valorRecebido    Decimal              @default(0) @db.Decimal(18, 2)
  dataPrevista     DateTime?
  dataRecebida     DateTime?
  status           StatusRecebivelVenda @default(PENDENTE)
  transacaoFonteId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  loja             Loja                 @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  venda            Venda                @relation(fields: [vendaId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([vendaId, lojaId])
}

// PD-02: devolução física em duas etapas; só a conferência apta cria estoque (lote novo, custo original).
model DevolucaoVenda {
  id                    String               @id @default(cuid())
  lojaId                String
  vendaId               String
  vendaItemId           String
  quantidade            Int
  estado                StatusDevolucaoVenda @default(PENDENTE)
  motivo                String
  registradoPorId       String
  conferidoPorId        String?
  conferidoEm           DateTime?
  condicaoComercial     CondicaoComercial?
  funcionamento         Funcionamento?
  observacaoConferencia String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  loja                  Loja                 @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  venda                 Venda                @relation(fields: [vendaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  item                  VendaItem            @relation(fields: [vendaItemId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@index([lojaId, estado])
  @@index([vendaItemId])
}

// PD-03: saída antiga sem lote (perda, ajuste, venda legada) atribuída explicitamente a um lote,
// por comando com motivo. Nunca automática; restaura Σ saldo dos lotes = estoque físico.
model ReconciliacaoLote {
  id                 String              @id @default(cuid())
  lojaId             String
  movimentoEntradaId String
  movimentoSaidaId   String
  quantidade         Int
  motivo             String
  usuarioId          String
  createdAt          DateTime            @default(now())
  loja               Loja                @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  lote               MovimentacaoEstoque @relation("ReconciliacaoLote", fields: [movimentoEntradaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  saida              MovimentacaoEstoque @relation("ReconciliacaoSaida", fields: [movimentoSaidaId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@index([lojaId, movimentoEntradaId])
  @@index([movimentoSaidaId])
}

// PD-04: conteúdo declarado do pacote (quantidade por item do pedido da loja). Opcional: sem ele,
// "a caminho" segue o destino do pedido.
model PacoteItem {
  id                 String           @id @default(cuid())
  lojaId             String
  pacoteExternoId    String
  pedidoCompraItemId String
  quantidade         Int
  createdAt          DateTime         @default(now())
  loja               Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pacote             PacoteExterno    @relation(fields: [pacoteExternoId], references: [id], onDelete: Restrict)
  item               PedidoCompraItem @relation(fields: [pedidoCompraItemId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([pacoteExternoId, pedidoCompraItemId])
  @@index([pedidoCompraItemId])
}

// Parâmetros econômicos de estimativa por loja. Cada gravação cria uma versão nova (append-only):
// alterar a configuração nunca recalcula simulações ou operações já registradas.
enum NotaFiscalBase {
  VENDA_BRUTA
  BASE_INFORMADA
}

enum ModalidadeTaxaMarketplace {
  A_VISTA
  PARCELADO
}

model ParametroEconomico {
  id                     String          @id @default(cuid())
  lojaId                 String
  versao                 Int
  // Acréscimo somado uma única vez à cotação de referência USD→BRL (valor em BRL por USD).
  acrescimoCambialBrl    Decimal         @db.Decimal(18, 6)
  freteValorPorKg        Decimal?        @db.Decimal(18, 6)
  freteMoeda             String?
  markupAlertaPercentual Decimal         @db.Decimal(8, 4)
  notaFiscalPercentual   Decimal?        @db.Decimal(8, 4)
  // Nula = base de incidência ainda não definida; a simulação exige escolha explícita.
  notaFiscalBase         NotaFiscalBase?
  iofPercentual          Decimal?        @db.Decimal(8, 4)
  observacoes            String?
  criadoPorId            String
  createdAt              DateTime        @default(now())

  loja             Loja                       @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  criadoPor        Usuario                    @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  taxasMarketplace TaxaMarketplaceParametro[]
  simulacoesCompra SimulacaoCompra[]

  @@unique([lojaId, versao])
  @@unique([id, lojaId])
}

model TaxaMarketplaceParametro {
  id                   String                    @id @default(cuid())
  lojaId               String
  parametroEconomicoId String
  canal                CanalVenda
  modalidade           ModalidadeTaxaMarketplace
  // Quantidade de parcelas do plano (obrigatória em PARCELADO, nula em A_VISTA).
  parcelas             Int?
  percentual           Decimal                   @db.Decimal(8, 4)
  descricao            String?

  parametro ParametroEconomico @relation(fields: [parametroEconomicoId, lojaId], references: [id, lojaId], onDelete: Cascade)

  @@index([lojaId, parametroEconomicoId])
}

// Simulação de compra: projeção, sem efeito operacional. Guarda a entrada resolvida (com os
// parâmetros e a cotação usados) e o resultado calculado como snapshot.
model SimulacaoCompra {
  id                   String   @id @default(cuid())
  lojaId               String
  nome                 String
  produtoId            String?
  produtoNome          String
  produtoCodigo        Int?
  parametroEconomicoId String?
  cotacaoCambioId      String?
  entrada              Json
  resultado            Json
  criadoPorId          String
  createdAt            DateTime @default(now())

  loja      Loja                @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  criadoPor Usuario             @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  parametro ParametroEconomico? @relation(fields: [parametroEconomicoId, lojaId], references: [id, lojaId], onDelete: Restrict)
  cotacao   CotacaoCambio?      @relation(fields: [cotacaoCambioId, lojaId], references: [id, lojaId], onDelete: Restrict)

  @@unique([id, lojaId])
  @@index([lojaId, createdAt])
}
