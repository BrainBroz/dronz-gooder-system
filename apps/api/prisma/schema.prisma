generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loja {
  projecoesCompra ProjecaoCompraItem[]
  id              String               @id @default(cuid())
  slug            String               @unique
  nome            String
  ativa           Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  usuarios                      UsuarioLoja[]
  categorias                    Categoria[]
  produtos                      Produto[]
  fornecedores                  Fornecedor[]
  pedidosCompra                 PedidoCompra[]
  pedidoCompraItens             PedidoCompraItem[]
  viajantes                     Viajante[]
  viagens                       Viagem[]
  malas                         Mala[]
  volumesLogisticos             VolumeLogistico[]
  alocacoesMala                 AlocacaoMala[]
  recebimentosMiami             RecebimentoMiami[]
  checkpointsParaguai           CheckpointParaguai[]
  checkpointsBrasil             CheckpointBrasil[]
  recebimentos                  Recebimento[]
  recebimentoItens              RecebimentoItem[]
  estoques                      Estoque[]
  estoquesEntradas              EstoqueEntrada[]
  movimentacoesEstoque          MovimentacaoEstoque[]
  cotacoesCambio                CotacaoCambio[]
  parametrosEconomicos          ParametroEconomico[]
  simulacoesCompra              SimulacaoCompra[]
  despesas                      Despesa[]
  contasFinanceiras             ContaFinanceira[]
  faturasCartao                 FaturaCartao[]
  lancamentosCartao             LancamentoCartao[]
  pagamentosFatura              PagamentoFatura[]
  transacoesFonte               TransacaoFinanceiraFonte[]
  conciliacoesFinanceiras       ConciliacaoFinanceira[]
  vendas                        Venda[]
  vendaItens                    VendaItem[]
  baixasVenda                   BaixaVenda[]
  recebiveisVenda               RecebivelVenda[]
  devolucoesVenda               DevolucaoVenda[]
  reconciliacoesLote            ReconciliacaoLote[]
  pacoteItens                   PacoteItem[]
  pagamentos                    Pagamento[]
  custosPedido                  CustoPedido[]
  handoffsVolume                HandoffVolume[]
  solicitacoesCorrecao          SolicitacaoCorrecao[]
  simulacoesViagem              SimulacaoViagem[]
  atribuicoes                   AtribuicaoItem[]
  comprasImportadas             CompraImportada[]
  atribuicoesCompraExterna      AtribuicaoCompraItem[]
  mapeamentosProdutoExterno     MapeamentoItemProduto[]
  mapeamentosMerchantFornecedor MapeamentoMerchantFornecedor[]
  materializacoesCompra         MaterializacaoCompra[]
  conexoesMarketplaceDedicadas  ConexaoMarketplace[]
}

model Usuario {
  projecoesCompra ProjecaoCompraItem[]
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  passwordHash    String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  lojas                          UsuarioLoja[]
  perfis                         UsuarioPerfil[]
  refreshTokens                  RefreshToken[]
  auditLogs                      AuditLog[]
  eventosCorretivos              EventoCorretivo[]
  recebimentosMiami              RecebimentoMiami[]
  checkpointsParaguai            CheckpointParaguai[]
  checkpointsBrasil              CheckpointBrasil[]
  estoquesEntradas               EstoqueEntrada[]
  recebimentosConfirmados        Recebimento[]
  movimentacoesEstoque           MovimentacaoEstoque[]
  cotacoesCambio                 CotacaoCambio[]
  conciliacoesRevisadas          ConciliacaoFinanceira[]
  vendasCriadas                  Venda[]                        @relation("VendaCriadaPor")
  vendasConfirmadas              Venda[]                        @relation("VendaConfirmadaPor")
  simulacoesViagemCriadas        SimulacaoViagem[]
  parametrosEconomicosCriados    ParametroEconomico[]
  simulacoesCompraCriadas        SimulacaoCompra[]
  atribuicoes                    AtribuicaoItem[]
  contasExternasCriadas          ContaExterna[]
  mapeamentosProdutoRevisados    MapeamentoItemProduto[]
  mapeamentosFornecedorRevisados MapeamentoMerchantFornecedor[]
  atribuicoesCompraExterna       AtribuicaoCompraItem[]
  materializacoesCompra          MaterializacaoCompra[]
  conflitosCompraResolvidos      ConflitoCompra[]
  conexoesMarketplaceCriadas     ConexaoMarketplace[]
  decisoesBuyerCompra            BuyerApprovalDecision[]
  responsabilidadesContextuais   ResponsabilidadeContextual[]
  handoffsEntregues              HandoffVolume[]
  conflitosBuyerResolvidos       BuyerReconciliationConflict[]  @relation("BuyerConflictResolver")
  correcoesPropostas             SolicitacaoCorrecao[]          @relation("CorrecaoProponente")
  correcoesDecididas             SolicitacaoCorrecao[]          @relation("CorrecaoAprovador")
  reservasMala                   AlocacaoMala[]
}

model Perfil {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   UsuarioPerfil[]
  permissoes PerfilPermissao[]
}

model Permissao {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perfis PerfilPermissao[]
}

model UsuarioLoja {
  id        String   @id @default(cuid())
  usuarioId String
  lojaId    String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  loja    Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, lojaId])
  @@index([lojaId])
}

model UsuarioPerfil {
  id        String   @id @default(cuid())
  usuarioId String
  perfilId  String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, perfilId])
  @@index([perfilId])
}

model PerfilPermissao {
  id          String   @id @default(cuid())
  perfilId    String
  permissaoId String
  createdAt   DateTime @default(now())

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@index([permissaoId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  usuarioId    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  usuarioId      String?
  action         String
  entity         String
  entityId       String?
  data           Json?
  lojaId         String?
  permissionCode String?
  correlationId  String?
  idempotencyKey String?
  reason         String?
  beforeData     Json?
  afterData      Json?
  origin         String?
  createdAt      DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([usuarioId])
  @@index([lojaId, createdAt])
  @@index([correlationId])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  lojaId         String
  operation      String
  entityId       String
  idempotencyKey String
  requestHash    String
  responseData   Json
  createdAt      DateTime @default(now())

  @@unique([lojaId, operation, entityId, idempotencyKey])
  @@index([lojaId, createdAt])
}

model EventoCorretivo {
  id              String                  @id @default(cuid())
  lojaId          String
  entity          String
  entityId        String
  originalEventId String
  correctionType  TipoCorrecaoOperacional
  reason          String
  beforeData      Json
  afterData       Json
  correlationId   String
  permissionCode  String
  usuarioId       String
  createdAt       DateTime                @default(now())
  usuario         Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([lojaId, entity, entityId, createdAt])
  @@index([originalEventId])
  @@index([correlationId])
}

enum TipoCorrecaoOperacional {
  DIVERGENCIA
  AJUSTE_RECEBIMENTO
  STOCK_COMPENSATION
}

model ProjecaoOperacional {
  id        String   @id @default(cuid())
  lojaId    String
  entity    String
  entityId  String
  state     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([lojaId, entity, entityId])
  @@index([lojaId, entity, updatedAt])
}

/// Cadastro geral de produtos que já trabalhamos, compartilhado pelas lojas (exceção deliberada ao lojaId:
/// não é estoque nem preço). Guarda o histórico de peso para estimar frete e reconhecer produtos nas compras.
model ProdutoBase {
  projecoes ProjecaoCompraItem[]
  id        String               @id @default(cuid())
  nome      String
  slug      String               @unique
  categoria String?
  pesoKg    Decimal?             @db.Decimal(10, 3)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([categoria])
}

/// Projeção econômica digitada por linha de compra importada e por loja (estimativa, nunca realizado):
/// venda projetada, peso e frete realmente pago. O vínculo com a base de produtos dá o peso reaproveitável.
model ProjecaoCompraItem {
  id               String   @id @default(cuid())
  itemExternoId    String
  lojaId           String
  produtoBaseId    String?
  vendaUnitariaBrl Decimal? @db.Decimal(14, 2)
  pesoKg           Decimal? @db.Decimal(10, 3)
  freteRealUsd     Decimal? @db.Decimal(14, 2)
  atualizadoPorId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  itemExterno   CompraImportadaItem @relation(fields: [itemExternoId], references: [id], onDelete: Cascade)
  loja          Loja                @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  produtoBase   ProdutoBase?        @relation(fields: [produtoBaseId], references: [id], onDelete: SetNull)
  atualizadoPor Usuario             @relation(fields: [atualizadoPorId], references: [id], onDelete: Restrict)

  @@unique([itemExternoId, lojaId])
  @@index([lojaId])
  @@index([produtoBaseId])
}

/// Foto de um anúncio externo (ex.: item do eBay), guardada à parte da evidência para não alterar o histórico de versões dos pedidos.
model ImagemAnuncioExterno {
  id        String              @id @default(cuid())
  provider  MarketplaceProvider
  anuncioId String
  url       String
  createdAt DateTime            @default(now())

  @@unique([provider, anuncioId])
}

model Categoria {
  id        String   @id @default(cuid())
  lojaId    String
  nome      String
  slug      String
  descricao String?
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loja     Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([lojaId, slug])
  @@unique([id, lojaId])
  @@index([lojaId])
  @@index([lojaId, ativo])
}

model Produto {
  id          String   @id @default(cuid())
  codigo      Int      @unique
  lojaId      String
  categoriaId String
  nome        String
  slug        String
  descricao   String?
  precoVenda  Decimal  @db.Decimal(10, 2)
  markup      Decimal  @db.Decimal(5, 2)
  peso        Decimal? @db.Decimal(10, 3)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loja                 Loja                    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoria            Categoria               @relation(fields: [categoriaId, lojaId], references: [id, lojaId], onDelete: Restrict)
  pedidoCompraItens    PedidoCompraItem[]
  estoques             Estoque[]
  recebimentoItens     RecebimentoItem[]
  movimentacoesEstoque MovimentacaoEstoque[]
  mapeamentosExternos  MapeamentoItemProduto[]
  vendaItens           VendaItem[]

  @@unique([lojaId, slug])
  @@unique([id, lojaId])
  @@index([lojaId])
  @@index([lojaId, categoriaId])
  @@index([lojaId, ativo])
}

enum PedidoCompraStatus {
  DRAFT
  PLACED
  CONFIRMED
  PARTIALLY_RECEIVED_MIAMI
  RECEIVED_MIAMI
  ALLOCATED_TO_TRIP
  IN_TRANSIT_BRAZIL
  ARRIVED_BRAZIL
  COMPLETED
  CANCELLED
}

model Fornecedor {
  id                  String                         @id @default(cuid())
  lojaId              String
  nome                String
  nomeFantasia        String?
  site                String?
  email               String?
  telefone            String?
  pais                String?
  moedaPadrao         String?
  observacoes         String?
  ativo               Boolean                        @default(true)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  loja                Loja                           @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pedidosCompra       PedidoCompra[]
  mapeamentosExternos MapeamentoMerchantFornecedor[]

  @@unique([id, lojaId])
  @@index([lojaId, ativo])
  @@index([lojaId, nome])
}

enum StatusAtribuicao {
  PENDENTE_ATRIBUICAO
  PARCIALMENTE_ATRIBUIDA
  ATRIBUIDA
  IGNORADA
  DUPLICADA
}

enum PlataformaCompraExterna {
  AMAZON
  EBAY
  WALMART
  BEST_BUY
  APPLE
  OUTRA
  MANUAL
  LEGACY_REVIEW
}

enum OrigemCompraExterna {
  API
  IMPORTACAO_ARQUIVO
  MANUAL
  LEGACY
}

enum StatusContaExterna {
  ATIVA
  INATIVA
}

enum MarketplaceProvider {
  AMAZON
  EBAY
}

enum EscopoConexaoMarketplace {
  SHARED
  STORE_DEDICATED
}

/// Para que serve a conta conectada: compras da loja ou compras pessoais (revisadas à parte, mas atribuíveis à loja).
enum FinalidadeConexao {
  LOJA
  PESSOAL
}

enum StatusConexaoMarketplace {
  NOT_CONFIGURED
  ACTIVE
  INACTIVE
  AUTHORIZATION_EXPIRED
  ERROR
}

enum StatusExecucaoSincronizacao {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
}

enum OrigemExecucaoSincronizacao {
  MANUAL
  REPLAY
  SCHEDULED
}

enum OrigemTrackingExterno {
  MARKETPLACE
  MANUAL
}

enum FonteEvidenciaCompra {
  AMAZON_BUSINESS_API
  EBAY_BUYER_API
  EMAIL_AMAZON
  EMAIL_EBAY
  EMAIL_OUTRO
  INVOICE
  DOCUMENTO
  CSV
  MANUAL
}

enum ClassificacaoEvidenciaCompra {
  DADOS_COMERCIAIS_NORMALIZADOS
}

enum EstadoCandidatoCompra {
  AGUARDANDO_APROVACAO
  COM_DIVERGENCIA
  APROVADA
  REJEITADA
  CANCELADA
}

enum DecisaoCandidatoCompra {
  APROVAR
  REJEITAR
}

enum TipoVinculoEvidenciaCompra {
  MATCHED
  SUPPORTING
  CONFLICTING
  REJECTED
}

enum TipoConflitoEvidenciaCompra {
  ORDER_DATE
  CURRENCY
  TOTAL
  MERCHANT
  ITEMS
  QUANTITY
  SHIPMENTS
  CANCELLATION_CHANGED
  EXTERNAL_STATUS
  POST_APPROVAL_EVIDENCE
  INVALID_PRIOR_EVIDENCE
  LEGACY_UNCLASSIFIED
}

enum StatusConflitoEvidenciaCompra {
  ABERTO
  RESOLVIDO
}

enum StatusMerchantExterno {
  ATIVO
  INATIVO
  EM_REVISAO
}

enum EstadoCompraImportada {
  IMPORTADA
  EM_REVISAO
  CANCELADA
  COM_DIVERGENCIA
}

enum EstrategiaIdentidadeLinha {
  EXTERNAL_LINE_ID
  FINGERPRINT
  LEGACY_REVIEW
}

enum StatusLinhaExterna {
  ATIVA
  CANCELADA
  COM_DIVERGENCIA
}

enum OrigemMapeamentoExterno {
  MANUAL
  IMPORTADO
}

enum StatusMapeamentoExterno {
  ATIVO
  INATIVO
}

enum StatusMaterializacaoCompra {
  CONCLUIDA
  BLOQUEADA
}

enum TipoConflitoCompra {
  QUANTITY_REDUCED_AFTER_ASSIGNMENT
  QUANTITY_REDUCED_AFTER_MATERIALIZATION
  EXTERNAL_ID_COLLISION
  MAPPING_CHANGED_AFTER_MATERIALIZATION
  DUPLICATE_EXTERNAL_ORDER
  STORE_ASSIGNMENT_OVERFLOW
  PRODUCT_NOT_FOUND
  PRODUCT_STORE_MISMATCH
  PAYLOAD_MISMATCH
  IDEMPOTENCY_CONFLICT
}

enum StatusConflitoCompra {
  ABERTO
  RESOLVIDO
}

model ContaExterna {
  id                      String                  @id @default(cuid())
  plataforma              PlataformaCompraExterna
  identificadorExterno    String
  nomeExibicao            String
  status                  StatusContaExterna      @default(ATIVA)
  origemIntegracao        OrigemCompraExterna
  metadata                Json?
  ultimaSincronizacaoEm   DateTime?
  ultimoErroSincronizacao String?
  criadoPorId             String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  criadoPor        Usuario                  @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  compras          CompraImportada[]
  conexoes         ConexaoMarketplace[]
  evidenciasCompra BuyerEvidence[]
  candidatosCompra BuyerPurchaseCandidate[]

  @@unique([plataforma, identificadorExterno])
  @@index([status, plataforma])
}

model ConexaoMarketplace {
  id                    String                   @id @default(cuid())
  provider              MarketplaceProvider
  contaExternaId        String
  nome                  String
  identificadorExterno  String
  regiao                String?
  marketplace           String?
  escopo                EscopoConexaoMarketplace
  finalidade            FinalidadeConexao        @default(LOJA)
  lojaPermitidaId       String?
  secretReference       String?
  status                StatusConexaoMarketplace @default(NOT_CONFIGURED)
  capabilities          String[]                 @default([])
  autorizadoEm          DateTime?
  autorizacaoExpiraEm   DateTime?
  ultimaSincronizacaoEm DateTime?
  cursorSincronizacao   String?
  ultimoErroSanitizado  String?
  version               Int                      @default(1)
  criadoPorId           String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  contaExterna      ContaExterna            @relation(fields: [contaExternaId], references: [id], onDelete: Restrict)
  lojaPermitida     Loja?                   @relation(fields: [lojaPermitidaId], references: [id], onDelete: Restrict)
  criadoPor         Usuario                 @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  execucoes         ExecucaoSincronizacao[]
  comprasImportadas CompraImportada[]
  evidenciasCompra  BuyerEvidence[]

  @@unique([provider, identificadorExterno])
  @@unique([contaExternaId])
  @@index([provider, status])
  @@index([escopo, lojaPermitidaId])
}

model ExecucaoSincronizacao {
  id             String                      @id @default(cuid())
  conexaoId      String
  status         StatusExecucaoSincronizacao @default(PENDING)
  origem         OrigemExecucaoSincronizacao
  cursorInicial  String?
  cursorFinal    String?
  janelaInicio   DateTime?
  janelaFim      DateTime?
  processados    Int                         @default(0)
  criados        Int                         @default(0)
  atualizados    Int                         @default(0)
  ignorados      Int                         @default(0)
  conflitos      Int                         @default(0)
  falhas         Int                         @default(0)
  correlationId  String                      @unique
  idempotencyKey String?
  requestHash    String?
  erroSanitizado String?
  iniciadoEm     DateTime?
  finalizadoEm   DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  conexao ConexaoMarketplace @relation(fields: [conexaoId], references: [id], onDelete: Restrict)

  @@unique([conexaoId, idempotencyKey])
  @@index([conexaoId, createdAt])
  @@index([status, createdAt])
}

model BuyerEvidence {
  id                        String                       @id @default(cuid())
  source                    FonteEvidenciaCompra
  sourceIdentity            String
  externalEvidenceId        String
  externalOrderIdNormalized String?
  contaExternaId            String?
  conexaoMarketplaceId      String?
  sourceOccurredAt          DateTime
  payloadHash               String
  version                   Int
  normalizedPayload         Json
  dataClassification        ClassificacaoEvidenciaCompra @default(DADOS_COMERCIAIS_NORMALIZADOS)
  correlationId             String
  createdAt                 DateTime                     @default(now())

  contaExterna         ContaExterna?                 @relation(fields: [contaExternaId], references: [id], onDelete: Restrict)
  conexaoMarketplace   ConexaoMarketplace?           @relation(fields: [conexaoMarketplaceId], references: [id], onDelete: Restrict)
  items                BuyerEvidenceItem[]
  candidateLinks       BuyerEvidenceLink[]
  currentForCandidates BuyerPurchaseCandidate[]      @relation("CurrentBuyerEvidence")
  approvalDecisions    BuyerApprovalDecision[]
  conflictReferences   BuyerReconciliationConflict[] @relation("BuyerConflictReference")
  conflictEvidence     BuyerReconciliationConflict[] @relation("BuyerConflictEvidence")

  @@unique([sourceIdentity, externalEvidenceId, payloadHash])
  @@unique([sourceIdentity, externalEvidenceId, version])
  @@index([source, externalOrderIdNormalized, createdAt])
  @@index([contaExternaId, createdAt])
  @@index([conexaoMarketplaceId, createdAt])
}

model BuyerPurchaseCandidate {
  id                        String                @id @default(cuid())
  provider                  MarketplaceProvider
  contaExternaId            String
  externalOrderIdNormalized String
  currentEvidenceId         String
  status                    EstadoCandidatoCompra @default(AGUARDANDO_APROVACAO)
  version                   Int                   @default(1)
  compraImportadaId         String?               @unique
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  contaExterna    ContaExterna                  @relation(fields: [contaExternaId], references: [id], onDelete: Restrict)
  currentEvidence BuyerEvidence                 @relation("CurrentBuyerEvidence", fields: [currentEvidenceId], references: [id], onDelete: Restrict)
  compraImportada CompraImportada?              @relation(fields: [compraImportadaId], references: [id], onDelete: Restrict)
  evidenceLinks   BuyerEvidenceLink[]
  decisions       BuyerApprovalDecision[]
  conflicts       BuyerReconciliationConflict[]

  @@unique([provider, contaExternaId, externalOrderIdNormalized], map: "BuyerPurchaseCandidate_provider_contaExternaId_order_key")
  @@index([status, updatedAt])
}

model BuyerEvidenceLink {
  id          String                     @id @default(cuid())
  candidateId String
  evidenceId  String
  type        TipoVinculoEvidenciaCompra @default(MATCHED)
  createdAt   DateTime                   @default(now())

  candidate BuyerPurchaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  evidence  BuyerEvidence          @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([candidateId, evidenceId])
  @@index([evidenceId])
}

model BuyerReconciliationConflict {
  id                  String                        @id @default(cuid())
  candidateId         String
  referenceEvidenceId String?
  evidenceId          String
  type                TipoConflitoEvidenciaCompra
  status              StatusConflitoEvidenciaCompra @default(ABERTO)
  resolucao           ResolucaoConflitoEvidencia?
  motivoResolucao     String?
  resolvidoPorId      String?
  resolvidoEm         DateTime?
  resolvidoPor        Usuario?                      @relation("BuyerConflictResolver", fields: [resolvidoPorId], references: [id], onDelete: Restrict)
  createdAt           DateTime                      @default(now())

  candidate         BuyerPurchaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  referenceEvidence BuyerEvidence?         @relation("BuyerConflictReference", fields: [referenceEvidenceId], references: [id], onDelete: Restrict)
  evidence          BuyerEvidence          @relation("BuyerConflictEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([candidateId, evidenceId, type])
  @@index([candidateId, status, createdAt])
  @@index([referenceEvidenceId])
}

model BuyerApprovalDecision {
  id               String                 @id @default(cuid())
  candidateId      String
  evidenceId       String
  candidateVersion Int
  decision         DecisaoCandidatoCompra
  actorId          String
  reason           String?
  correlationId    String
  idempotencyKey   String
  createdAt        DateTime               @default(now())

  candidate BuyerPurchaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  evidence  BuyerEvidence          @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  actor     Usuario                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([candidateId, candidateVersion])
  @@index([actorId, createdAt])
}

model BuyerEvidenceItem {
  id                    String  @id @default(cuid())
  evidenceId            String
  externalLineId        String?
  identityFingerprint   String
  identityDiscriminator Int
  title                 String
  variation             String?
  sku                   String?
  asin                  String?
  offerId               String?
  quantity              Int
  cancelledQuantity     Int
  refundedQuantity      Int
  unitPrice             Decimal @db.Decimal(14, 2)
  currency              String

  evidence BuyerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, identityFingerprint, identityDiscriminator], map: "BuyerEvidenceItem_evidenceId_identityFingerprint_identityDiscri")
  @@index([externalLineId])
}

model MerchantExterno {
