DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dronz_gooder
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/dronz_gooder_test?schema=public
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-distinct-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
VITE_API_URL=http://localhost:3001
# Referências locais opcionais; adapters reais permanecem desabilitados no Batch 8.
MARKETPLACE_AMAZON_CONNECTION_SECRET=
MARKETPLACE_EBAY_CONNECTION_SECRET=
# Adapter eBay Buyer (Batch 11): desligado por padrão. A credencial fica fora do Git, em secret manager
# exposto como MARKETPLACE_EBAY_<NOME>={"clientId":"…","clientSecret":"…","refreshToken":"…"}.
MARKETPLACE_EBAY_BUYER_ENABLED=false
# PD-12: perda/ajuste negativo acima deste número de unidades exige aval (vazio = sem aprovação extra).
ESTOQUE_PERDA_LIMITE_UNIDADES=
